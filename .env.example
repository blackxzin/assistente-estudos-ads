# Banco de dados
DATABASE_URL=postgresql+asyncpg://assistente:assistente@postgres:5432/assistente_estudos
POSTGRES_USER=assistente
POSTGRES_PASSWORD=assistente
POSTGRES_DB=assistente_estudos

# Autenticacao (use pelo menos 32 caracteres aleatorios em produção)
JWT_SECRET=troque-este-valor

# Provedor de IA (openai, anthropic ou falso para testes sem API real)
IA_PROVEDOR=openai
IA_API_KEY=

# Provedor de embeddings (Anthropic nao tem; use openai ou falso)
EMBEDDING_PROVEDOR=openai
EMBEDDING_DIM=1536

AMBIENTE=development

# CORS: origens do frontend que podem chamar a API, separadas por vírgula
CORS_ORIGINS=http://localhost:3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
